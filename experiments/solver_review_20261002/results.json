  "research_status": {
    "same_frequency_nested_hp": {
      "scope": "Same twelve single-polarization 96-panel cases and 37 angles, two warm repeats. Each measured path rebuilds both polynomial meshes and material preparation; the restricted path also includes its coarse layout and sparse prolongation construction. Both dense solves and field projections included. Existing shared near-moment cache enabled in the separate-assembly baseline. This is a dense pair experiment, not the full certified co-polarized production workflow.",
      "sum_of_separate_case_medians_seconds": 5.551892899988161,
      "sum_of_restricted_case_medians_seconds": 4.049888449993887,
      "aggregate_time_reduction_percent": 27.05391615168724,
      "individual_case_reduction_range_percent": [
        11.4093634237166,
        33.839978380947464
      ],
      "maximum_quadratic_field_change_over_peak": 1.2988992855802902e-13,
      "maximum_cubic_field_change": 0.0,
      "limitation": "Production also shares assembly across polarizations and has compressed factorization, quality gates, profiling, resource admission and metadata work; those costs are not represented by this dense microbenchmark. No full-airfoil gain is inferred."
    },
    "directional_h2_or_fmm": {
      "status": "Working directional far-kernel interpolation proof of concept on actual airfoil nodes; no full H2/FMM operator or solver implemented.",
      "reference_implementation_caveat": "Timing reference is direct scipy.special.hankel2 evaluation. This is not a speed comparison against GHOST native kernel tables or assembled Galerkin coefficients. Full reference validation is excluded from candidate timing; production needs independent error accounting to avoid evaluating the entire reference.",
      "accuracy_caveat": "At 16 by 12 terms the 10 GHz error is 5.1e-15 and kernel-demo time is 39.0% lower, with 25% fewer representation array bytes. At 18 GHz the error plateaus near 1.5e-14, slightly above the current 1e-14 tile-compression tolerance. The 12 by 12 demonstration is therefore not a production-qualified replacement. There is no full-Galerkin, material, field or process-peak RAM result from this experiment, and existing tile compression already reduces storage relative to dense matrices."
    },
    "higher_order_bor": {
      "status": "Architecture design only; not implemented or benchmarked here.",
      "finding": "bor/kernels.py gauss_on_generatrix interpolates rho and z linearly between endpoints and carries T0=1-s, T1=s plus their radius-weighted derivatives. Raising quadrature alone does not add higher-order geometry or current degrees of freedom.",
      "blockers": [
        "Introduce higher-order current basis and radius-weighted derivatives consistently in every modal kernel family, DOF map, excitation and far-field projection.",
        "Derive singular/self/near quadrature for the enriched basis, including axis endpoint regularity and modal constraints.",
        "Preserve explicit input corners and material junctions. Curved geometry needs an explicit curve representation; silently smoothing polygon input changes the problem.",
        "Compare DOFs, runtime, process-tree RAM and independent field accuracy on smooth bodies, sharp features, lossy layers and both polarizations."
      ]
    }
  },
